# Flask
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=attendance_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=pazo_attendance

# Used only by `flask seed-admin` when creating the first admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pazo.local
ADMIN_PASSWORD=ChangeMe@2026!

# Optional regional holiday calendar: blank for India-wide; use MH for Maharashtra
HOLIDAY_SUBDIV=
